{
 "$comment": "Score brief (openspec change score-composition-pipeline). Validated by tool/music/compose/brief.mjs, which also checks cross-references: voices against tool/music/voices.json, sections against form, parts against tiers.",
 "type": "object",
 "additionalProperties": false,
 "required": ["schemaVersion", "id", "title", "stat", "prompt", "seed", "bpm", "meter", "keys", "form", "harmony", "groove", "voices", "parts", "tiers", "motifs"],
 "properties": {
  "$comment": {"type": "string"},
  "schemaVersion": {"enum": [1]},
  "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
  "title": {"type": "string", "minLength": 1},
  "stat": {"type": "string", "minLength": 1},
  "prompt": {"type": "string", "minLength": 1},
  "style": {"type": "string"},
  "color": {"type": "string"},
  "seed": {"type": "integer", "minimum": 0},
  "bpm": {"type": "number", "minimum": 40, "maximum": 240},
  "meter": {"enum": ["4/4"]},
  "keys": {
   "type": "array", "minItems": 1,
   "items": {
    "type": "object", "additionalProperties": false, "required": ["section", "root", "mode"],
    "properties": {
     "section": {"type": "string"},
     "root": {"enum": ["C", "C#", "Db", "D", "D#", "Eb", "E", "F", "F#", "Gb", "G", "G#", "Ab", "A", "A#", "Bb", "B"]},
     "mode": {"enum": ["major", "minor", "dorian", "mixolydian", "phrygian", "harmonicMinor"]}
    }
   }
  },
  "form": {
   "type": "array", "minItems": 1,
   "items": {
    "type": "object", "additionalProperties": false, "required": ["section", "bars", "name"],
    "properties": {
     "section": {"type": "string"},
     "bars": {"type": "integer", "minimum": 2},
     "name": {"type": "string"}
    }
   }
  },
  "harmonicRhythmBars": {"type": "integer", "minimum": 1, "maximum": 4},
  "harmony": {"type": "object", "additionalProperties": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[b#]?(i|ii|iii|iv|v|vi|vii|I|II|III|IV|V|VI|VII)(o|7)?$"}}},
  "groove": {
   "type": "object", "additionalProperties": false, "required": ["pattern"],
   "properties": {
    "pattern": {"enum": ["cumbia", "son", "train-beat", "half-time"]},
    "swing": {"type": "number", "minimum": 0, "maximum": 0.25},
    "layers": {"type": "array", "items": {"enum": ["cumbia-guacharaca", "clave", "double-time-kick"]}}
   }
  },
  "voices": {"type": "array", "minItems": 1, "items": {"type": "string"}},
  "parts": {
   "type": "array", "minItems": 1,
   "items": {
    "type": "object", "additionalProperties": false, "required": ["id", "track", "voice", "role"],
    "properties": {
     "id": {"type": "string"},
     "track": {"type": "string"},
     "voice": {"type": "string"},
     "role": {"enum": ["percussion", "bass", "comp", "pad", "melody", "counter", "stabs"]},
     "kit": {"enum": ["core", "lift", "bright", "fills", "clave", "anchor", "conga", "cascara", "campana", "shaker"]},
     "style": {"enum": ["root-fifth", "walking", "tumbao", "pedal", "offbeat-dyads", "offbeat-triads", "arpeggio", "montuno", "arp16", "mambo", "hook", "full", "held"]},
     "sections": {"type": "array", "minItems": 1, "items": {"type": "string"}},
     "motif": {"type": "string"},
     "plan": {"type": "object", "additionalProperties": {"type": "array", "minItems": 1, "items": {"enum": ["statement", "sequence", "displace", "invert", "fragment", "ornament", "answer", "cadence"]}}},
     "register": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer", "minimum": 0, "maximum": 127}},
     "velocity": {"type": "integer", "minimum": 1, "maximum": 127},
     "program": {"type": "integer", "minimum": 0, "maximum": 127}
    }
   }
  },
  "tiers": {
   "type": "array", "minItems": 5, "maxItems": 5,
   "items": {
    "type": "object", "additionalProperties": false, "required": ["name", "adds"],
    "properties": {
     "name": {"type": "string"},
     "adds": {"type": "array", "items": {"type": "string"}},
     "removes": {"type": "array", "items": {"type": "string"}}
    }
   }
  },
  "motifs": {"type": "object", "additionalProperties": {"type": "string"}},
  "transitions": {
   "type": "object", "additionalProperties": false,
   "properties": {
    "successIntent": {"type": "string"},
    "bridgeIntent": {"type": "string"}
   }
  },
  "gameplayReference": {"type": "object"},
  "budgetBytes": {"type": "integer", "minimum": 1}
 }
}
