{
 "id": "party-pixel",
 "description": "Current working art direction for party characters. Not final: edit freely, and impact analysis reports every character affected.",
 "prompt": "pixel art game sprite, full body, single character, 16-bit, crisp pixel clusters, clean dark outline, flat shading, plain light grey background",
 "negative": "multiple characters, sprite sheet, grid, text, logo, watermark, blur, motion blur, cropped feet, cropped hat, floor shadow, photorealistic, 3d render",
 "backend": "qwen-frame",
 "frame": {
  "margin": {
   "minClear": 0.03,
   "units": "fraction-of-generation-canvas",
   "failOnBorderTouch": true
  },
  "units": "native-px",
  "generationCanvas": {
   "width": 768,
   "height": 960
  },
  "camera": "floor-perspective"
 },
 "transparency": {
  "byBackend": {
   "sdxl": "matte",
   "default": "matte"
  },
  "matte": "birefnet",
  "alpha": "binary"
 },
 "outline": "#1A1018",
 "symmetry": "none",
 "reservedRamps": [
  {
   "id": "kumbia-outfit",
   "appliesToRegions": [
    "cloth"
   ],
   "recolor": false,
   "$comment": "Gates from shaders/party_palette.frag on unpremultiplied RGB 0-1; matches if ANY gate's ALL conditions hold. Structured, never eval'd: lhs is a channel or {sub:[a,b]}, rhs a literal or {mul:[k,channel]}.",
   "gates": [
    {
     "id": "cool",
     "all": [
      {
       "lhs": "b",
       "op": ">=",
       "rhs": 0.12
      },
      {
       "lhs": "r",
       "op": ">=",
       "rhs": {
        "mul": [
         0.7,
         "b"
        ]
       }
      },
      {
       "lhs": "b",
       "op": ">=",
       "rhs": {
        "mul": [
         0.99,
         "r"
        ]
       }
      },
      {
       "lhs": "g",
       "op": ">=",
       "rhs": {
        "mul": [
         0.2,
         "b"
        ]
       }
      },
      {
       "lhs": "g",
       "op": "<=",
       "rhs": {
        "mul": [
         0.66,
         "b"
        ]
       }
      }
     ]
    },
    {
     "id": "plum",
     "all": [
      {
       "lhs": "r",
       "op": ">=",
       "rhs": 0.392157
      },
      {
       "lhs": "r",
       "op": ">=",
       "rhs": {
        "mul": [
         0.7,
         "b"
        ]
       }
      },
      {
       "lhs": "b",
       "op": ">=",
       "rhs": {
        "mul": [
         0.32,
         "r"
        ]
       }
      },
      {
       "lhs": "g",
       "op": "<=",
       "rhs": {
        "mul": [
         0.55,
         "b"
        ]
       }
      },
      {
       "lhs": {
        "sub": [
         "b",
         "g"
        ]
       },
       "op": ">=",
       "rhs": 0.047059
      }
     ]
    },
    {
     "id": "pink",
     "all": [
      {
       "lhs": "r",
       "op": ">=",
       "rhs": 0.705882
      },
      {
       "lhs": "r",
       "op": ">=",
       "rhs": {
        "mul": [
         0.7,
         "b"
        ]
       }
      },
      {
       "lhs": "b",
       "op": ">=",
       "rhs": {
        "mul": [
         0.32,
         "r"
        ]
       }
      },
      {
       "lhs": "g",
       "op": "<=",
       "rhs": {
        "mul": [
         0.86,
         "b"
        ]
       }
      },
      {
       "lhs": {
        "sub": [
         "b",
         "g"
        ]
       },
       "op": ">=",
       "rhs": 0.047059
      }
     ]
    }
   ]
  }
 ],
 "qa": {
  "inherit": [
   "coverage",
   "single_object",
   "border_touch",
   "slot_fill"
  ],
  "add": [
   {
    "id": "baseline_drift",
    "maxPx": 1,
    "scope": "consecutive drawings sharing a planted support foot",
    "camera": "from target"
   },
   {
    "id": "head_size_variance",
    "maxPct": 4,
    "scope": "family"
   },
   {
    "id": "region_gate_agreement",
    "rule": "non-cloth pixels outside all reservedRamps gates; cloth pixels inside one"
   },
   {
    "id": "identity_similarity",
    "against": "references",
    "threshold": "TBD",
    "embedding": {
     "model": "facebook/dinov2-small",
     "licence": "apache-2.0",
     "status": "pending operator approval"
    }
   }
  ],
  "static": [
   {
    "id": "palette_fails_all_gates",
    "rule": "outline and palette entries outside cloth fail every kumbia-outfit gate"
   },
   {
    "id": "region_mask_colours_declared",
    "rule": "every regionMask pixel is a declared regions colour or fully transparent"
   }
  ]
 },
 "adapters": {
  "enum": [
   "ip-adapter-sdxl",
   "qwen-image-edit",
   "img2img"
  ]
 },
 "regionsRender": {
  "antialias": false,
  "filtering": "none"
 },
 "generation": {
  "count_per_pose": 4,
  "seed_policy": "seed = seed_base + 100*pose_index + k; fixed per pose while tuning",
  "tier": "I1"
 },
 "ramp": {
  "shades": 4
 }
}
