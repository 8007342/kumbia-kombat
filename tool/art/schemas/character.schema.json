{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Kumbia character definition",
 "type": "object",
 "additionalProperties": false,
 "required": ["id", "style", "body", "garments", "motion"],
 "properties": {
  "$comment": {"type": "string"},
  "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
  "family": {"type": "string"},
  "status": {"enum": ["active", "rig-only", "drawn"]},
  "style": {"type": "string"},
  "backend": {"type": ["string", "null"]},
  "description": {"type": "string"},
  "body": {"type": "object", "additionalProperties": false, "required": ["preset"],
           "properties": {"preset": {"type": "string"}, "overrides": {"type": "object"}}},
  "pronouns": {"type": "array", "items": {"type": "string"}, "minItems": 3, "maxItems": 3},
  "skin": {"$ref": "#/$defs/colour"},
  "traits": {"type": "string"},
  "demeanor": {"type": "string"},
  "negative": {"type": "string"},
  "styleGuide": {"type": "object", "additionalProperties": {"type": "string"}},
  "garments": {"type": "array", "items": {"$ref": "#/$defs/garment"}},
  "props": {"type": "array", "items": {"$ref": "#/$defs/prop"}},
  "drawing": {"$ref": "#/$defs/drawing"},
  "motion": {"type": "object", "additionalProperties": false, "required": ["set"],
             "properties": {"set": {"type": "string"},
                            "overrides": {"type": "object", "additionalProperties": {
                              "type": "object", "additionalProperties": false,
                              "properties": {"pose": {"type": "object"}, "intent": {"type": "string"}}}}}},
  "references": {"type": "object", "additionalProperties": false, "required": ["mode", "sources"],
                 "properties": {"mode": {"enum": ["source", "derive"]},
                                "sources": {"type": "array", "items": {"$ref": "#/$defs/reference"}}}},
  "targets": {"type": "array", "items": {"$ref": "#/$defs/target"}},
  "seedBase": {"type": "integer", "minimum": 0},
  "variants": {"type": "object", "additionalProperties": {"$ref": "#/$defs/variant"}}
 },
 "$defs": {
  "colour": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
  "drawing": {"type": "object", "additionalProperties": false, "required": ["noun", "fits", "look", "sheet"],
   "description": "What the Qwen route needs: identity words, the model sheet, and hand fixes that survive re-planning.",
   "properties": {"$comment": {"type": "string"},
                  "noun": {"type": "string"}, "fits": {"type": "string"}, "look": {"type": "string"}, "extra": {"type": "string"},
                  "motion": {"type": "string", "description": "A motion file with its own poses: posed by words and a sheet view, with no rig."},
                  "seed": {"type": "integer", "minimum": 0}, "count": {"type": "integer", "minimum": 1},
                  "skeletonScale": {"type": "number", "exclusiveMinimum": 0},
                  "buildReference": {"type": "object", "additionalProperties": false, "required": ["image"],
                                     "properties": {"image": {"type": "string"},
                                                    "rect": {"type": "array", "items": {"type": "integer"}, "minItems": 4, "maxItems": 4}}},
                  "sheet": {"type": "object", "additionalProperties": false, "required": ["views"],
                            "properties": {"source": {"type": "object", "additionalProperties": false, "required": ["image"],
                                                      "properties": {"image": {"type": "string"}, "styleOnly": {"type": "boolean"},
                                                                     "rect": {"type": "array", "items": {"type": "integer"}, "minItems": 4, "maxItems": 4}}},
                                           "views": {"type": "object", "minProperties": 1, "additionalProperties": {
                                             "type": "object", "additionalProperties": false, "required": ["image"],
                                             "properties": {"image": {"type": "string"}, "description": {"type": "string"}, "look": {"type": "string"}, "extra": {"type": "string"}, "stageScale": {"type": "number", "exclusiveMinimum": 0, "maximum": 1, "description": "Show the model this view smaller, about its bottom centre, when a sheet that fills its frame makes standing poses run off the top."}}}}}},
                  "accepted": {"type": "object", "additionalProperties": false, "required": ["run"],
                               "properties": {"run": {"type": "string"}, "note": {"type": "string"}}},
                  "poseOverrides": {"type": "object", "additionalProperties": {
                    "type": "object", "additionalProperties": false,
                    "properties": {"why": {"type": "string"}, "description": {"type": "string"}, "props": {"type": "string"},
                                   "skeletonScale": {"type": "number", "exclusiveMinimum": 0}}}},
                  "skeletonOverrides": {"type": "object", "additionalProperties": {"type": "object", "additionalProperties": {
                    "type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2}}},
                  "score": {"type": "object", "additionalProperties": false,
                            "properties": {"knee": {"type": "array", "items": {"type": "string"}, "minItems": 1},
                                           "ankle": {"type": "array", "items": {"type": "string"}, "minItems": 1},
                                           "silhouetteTolerance": {"type": "integer", "minimum": 0}}},
                  "register": {"type": "object", "additionalProperties": false,
                               "required": ["standingHeightPx", "floorY", "centerX", "stature", "referenceFrame", "referenceWorldHeight"],
                               "properties": {"standingHeightPx": {"type": "integer"}, "floorY": {"type": "integer"}, "centerX": {"type": "integer"},
                                              "stature": {"type": "number"}, "referenceFrame": {"type": "string"},
                                              "referenceWorldHeight": {"type": "number"}, "pixelScale": {"type": "integer"}}}}},
  "garment": {"type": "object", "additionalProperties": false, "required": ["id", "shape", "region"],
   "properties": {"id": {"type": "string"}, "shape": {"type": "string"}, "region": {"type": "string"},
                  "colour": {"$ref": "#/$defs/colour"}, "text": {"type": "string"},
                  "recolourable": {"type": "boolean"}, "nudge": {"type": "boolean"},
                  "alsoIn": {"type": "array", "items": {"type": "string"}},
                  "secondaryMotion": {"type": "string"}, "params": {"type": "object"}}},
  "prop": {"type": "object", "additionalProperties": false, "required": ["id", "kind", "hand", "colour"],
   "properties": {"id": {"type": "string"}, "kind": {"type": "string"}, "hand": {"enum": ["left", "right"]},
                  "colour": {"$ref": "#/$defs/colour"}, "text": {"type": "string"},
                  "wording": {"enum": ["picture-side", "own-hand"]},
                  "clips": {"type": "array", "items": {"type": "string"}}}},
  "reference": {"type": "object", "additionalProperties": false, "required": ["role", "image"],
   "properties": {"role": {"type": "string"}, "image": {"type": "string"}, "crop": {"type": "object"},
                  "adapter": {"type": "string"}, "weight": {"type": "number"}, "regions": {"type": "array", "items": {"type": "string"}}}},
  "target": {"type": "object", "additionalProperties": false, "required": ["room", "atlas", "native", "pixelScale"],
   "properties": {"room": {"type": "string"}, "atlas": {"type": "string"}, "out": {"type": "string"},
                  "native": {"type": "array", "items": {"type": "integer"}, "minItems": 2, "maxItems": 2},
                  "pixelScale": {"type": "integer"}, "camera": {"enum": ["floor-perspective", "side-on"]}}},
  "variant": {"type": "object", "additionalProperties": false,
   "properties": {"colours": {"type": "object", "additionalProperties": {"$ref": "#/$defs/colour"}},
                  "garments": {"type": "array", "items": {"$ref": "#/$defs/garment"}},
                  "description": {"type": "string"}}}
 }
}
