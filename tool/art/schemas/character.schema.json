{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Kumbia character definition",
 "type": "object",
 "additionalProperties": false,
 "required": ["id", "style", "body", "garments", "motion"],
 "properties": {
  "$comment": {"type": "string"},
  "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
  "family": {"type": "string"},
  "status": {"enum": ["active", "rig-only"]},
  "style": {"type": "string"},
  "backend": {"type": ["string", "null"]},
  "description": {"type": "string"},
  "body": {"type": "object", "additionalProperties": false, "required": ["preset"],
           "properties": {"preset": {"type": "string"}, "overrides": {"type": "object"}}},
  "pronouns": {"type": "array", "items": {"type": "string"}, "minItems": 3, "maxItems": 3},
  "skin": {"$ref": "#/$defs/colour"},
  "traits": {"type": "string"},
  "demeanor": {"type": "string"},
  "garments": {"type": "array", "items": {"$ref": "#/$defs/garment"}},
  "props": {"type": "array", "items": {"$ref": "#/$defs/prop"}},
  "motion": {"type": "object", "additionalProperties": false, "required": ["set"],
             "properties": {"set": {"type": "string"},
                            "overrides": {"type": "object", "additionalProperties": {
                              "type": "object", "additionalProperties": false,
                              "properties": {"pose": {"type": "object"}, "intent": {"type": "string"}}}}}},
  "references": {"type": "object", "additionalProperties": false, "required": ["mode", "sources"],
                 "properties": {"mode": {"enum": ["source", "derive"]},
                                "sources": {"type": "array", "items": {"$ref": "#/$defs/reference"}}}},
  "targets": {"type": "array", "items": {"$ref": "#/$defs/target"}},
  "seedBase": {"type": "integer", "minimum": 0},
  "variants": {"type": "object", "additionalProperties": {"$ref": "#/$defs/variant"}}
 },
 "$defs": {
  "colour": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
  "garment": {"type": "object", "additionalProperties": false, "required": ["id", "shape", "region"],
   "properties": {"id": {"type": "string"}, "shape": {"type": "string"}, "region": {"type": "string"},
                  "colour": {"$ref": "#/$defs/colour"}, "text": {"type": "string"},
                  "recolourable": {"type": "boolean"}, "nudge": {"type": "boolean"},
                  "secondaryMotion": {"type": "string"}, "params": {"type": "object"}}},
  "prop": {"type": "object", "additionalProperties": false, "required": ["id", "kind", "hand", "colour"],
   "properties": {"id": {"type": "string"}, "kind": {"type": "string"}, "hand": {"enum": ["left", "right"]},
                  "colour": {"$ref": "#/$defs/colour"}, "text": {"type": "string"},
                  "clips": {"type": "array", "items": {"type": "string"}}}},
  "reference": {"type": "object", "additionalProperties": false, "required": ["role", "image"],
   "properties": {"role": {"type": "string"}, "image": {"type": "string"}, "crop": {"type": "object"},
                  "adapter": {"type": "string"}, "weight": {"type": "number"}, "regions": {"type": "array", "items": {"type": "string"}}}},
  "target": {"type": "object", "additionalProperties": false, "required": ["room", "atlas", "native", "pixelScale"],
   "properties": {"room": {"type": "string"}, "atlas": {"type": "string"}, "out": {"type": "string"},
                  "native": {"type": "array", "items": {"type": "integer"}, "minItems": 2, "maxItems": 2},
                  "pixelScale": {"type": "integer"}, "camera": {"enum": ["floor-perspective", "side-on"]}}},
  "variant": {"type": "object", "additionalProperties": false,
   "properties": {"colours": {"type": "object", "additionalProperties": {"$ref": "#/$defs/colour"}},
                  "garments": {"type": "array", "items": {"$ref": "#/$defs/garment"}},
                  "description": {"type": "string"}}}
 }
}
